{
  "version": 2,
  "buildCommand": "cd apps/web && npm run build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next@latest",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ]
}
